{
  "name": "tinita",
  "version": "0.0.1",
  "description": "Modern TypeScript utility library with tree-shaking support - zero dependencies, type-safe, framework-agnostic",
  "author": {
    "name": "DungGramer",
    "email": "dung.dev.gramer@gmail.com",
    "url": "https://dunggramer.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunggramer/tinita.git",
    "directory": "packages/tinita"
  },
  "homepage": "https://github.com/dunggramer/tinita#readme",
  "bugs": {
    "url": "https://github.com/dunggramer/tinita/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsup",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./file/fileSize": {
      "types": "./dist/file/fileSize.d.ts",
      "import": "./dist/file/fileSize.mjs",
      "require": "./dist/file/fileSize.cjs"
    },
    "./file/getFileNameParts": {
      "types": "./dist/file/getFileNameParts.d.ts",
      "import": "./dist/file/getFileNameParts.mjs",
      "require": "./dist/file/getFileNameParts.cjs"
    },
    "./file/truncateFileName": {
      "types": "./dist/file/truncateFileName.d.ts",
      "import": "./dist/file/truncateFileName.mjs",
      "require": "./dist/file/truncateFileName.cjs"
    },
    "./uuid/generateUUID": {
      "types": "./dist/uuid/generateUUID.d.ts",
      "import": "./dist/uuid/generateUUID.mjs",
      "require": "./dist/uuid/generateUUID.cjs"
    },
    "./download": {
      "types": "./dist/download/index.d.ts",
      "import": "./dist/download/index.mjs",
      "require": "./dist/download/index.cjs"
    },
    "./download/download": {
      "types": "./dist/download/download.d.ts",
      "import": "./dist/download/download.mjs",
      "require": "./dist/download/download.cjs"
    },
    "./download/downloadFromUrl": {
      "types": "./dist/download/download-from-url.d.ts",
      "import": "./dist/download/download-from-url.mjs",
      "require": "./dist/download/download-from-url.cjs"
    },
    "./download/prepareDownload": {
      "types": "./dist/download/prepare-download.d.ts",
      "import": "./dist/download/prepare-download.mjs",
      "require": "./dist/download/prepare-download.cjs"
    },
    "./download/toBlob": {
      "types": "./dist/download/to-blob.d.ts",
      "import": "./dist/download/to-blob.mjs",
      "require": "./dist/download/to-blob.cjs"
    },
    "./download/resolveFilename": {
      "types": "./dist/download/resolve-filename.d.ts",
      "import": "./dist/download/resolve-filename.mjs",
      "require": "./dist/download/resolve-filename.cjs"
    },
    "./download/fetchWithTimeout": {
      "types": "./dist/download/fetch-with-timeout.d.ts",
      "import": "./dist/download/fetch-with-timeout.mjs",
      "require": "./dist/download/fetch-with-timeout.cjs"
    },
    "./download/downloadBlob": {
      "types": "./dist/download/download-blob.d.ts",
      "import": "./dist/download/download-blob.mjs",
      "require": "./dist/download/download-blob.cjs"
    },
    "./download/formatBytes": {
      "types": "./dist/download/format-bytes.d.ts",
      "import": "./dist/download/format-bytes.mjs",
      "require": "./dist/download/format-bytes.cjs"
    },
    "./download/formatDuration": {
      "types": "./dist/download/format-duration.d.ts",
      "import": "./dist/download/format-duration.mjs",
      "require": "./dist/download/format-duration.cjs"
    },
    "./download/sanitizeFilename": {
      "types": "./dist/download/sanitize-filename.d.ts",
      "import": "./dist/download/sanitize-filename.mjs",
      "require": "./dist/download/sanitize-filename.cjs"
    },
    "./download/isRetryableError": {
      "types": "./dist/download/is-retryable-error.d.ts",
      "import": "./dist/download/is-retryable-error.mjs",
      "require": "./dist/download/is-retryable-error.cjs"
    },
    "./download/smoothProgress": {
      "types": "./dist/download/smooth-progress.d.ts",
      "import": "./dist/download/smooth-progress.mjs",
      "require": "./dist/download/smooth-progress.cjs"
    },
    "./download/retryDownload": {
      "types": "./dist/download/retry-download.d.ts",
      "import": "./dist/download/retry-download.mjs",
      "require": "./dist/download/retry-download.cjs"
    },
    "./download/minDurationDelay": {
      "types": "./dist/download/min-duration-delay.d.ts",
      "import": "./dist/download/min-duration-delay.mjs",
      "require": "./dist/download/min-duration-delay.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/DungGramer"
  },
  "keywords": [
    "typescript",
    "utilities",
    "tree-shaking",
    "type-safe",
    "validation",
    "file-utils",
    "uuid",
    "esm",
    "cjs"
  ],
  "devDependencies": {
    "happy-dom": "^20.8.9"
  }
}
