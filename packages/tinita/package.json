{
  "name": "tinita",
  "version": "0.1.0",
  "description": "Modern TypeScript utility library with tree-shaking support - zero dependencies, type-safe, framework-agnostic",
  "author": {
    "name": "DungGramer",
    "email": "dung.dev.gramer@gmail.com",
    "url": "https://dunggramer.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunggramer/tinita.git",
    "directory": "packages/tinita"
  },
  "homepage": "https://github.com/dunggramer/tinita#readme",
  "bugs": {
    "url": "https://github.com/dunggramer/tinita/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "file/fileSize": [
        "dist/file/fileSize.d.ts"
      ],
      "file/getFileNameParts": [
        "dist/file/getFileNameParts.d.ts"
      ],
      "file/truncateFileName": [
        "dist/file/truncateFileName.d.ts"
      ],
      "file/truncateFileNameParts": [
        "dist/file/truncateFileNameParts.d.ts"
      ],
      "uuid/generateUUID": [
        "dist/uuid/generateUUID.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsup",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./file/fileSize": {
      "import": {
        "types": "./dist/file/fileSize.d.mts",
        "default": "./dist/file/fileSize.mjs"
      },
      "require": {
        "types": "./dist/file/fileSize.d.ts",
        "default": "./dist/file/fileSize.cjs"
      }
    },
    "./file/getFileNameParts": {
      "import": {
        "types": "./dist/file/getFileNameParts.d.mts",
        "default": "./dist/file/getFileNameParts.mjs"
      },
      "require": {
        "types": "./dist/file/getFileNameParts.d.ts",
        "default": "./dist/file/getFileNameParts.cjs"
      }
    },
    "./file/truncateFileName": {
      "import": {
        "types": "./dist/file/truncateFileName.d.mts",
        "default": "./dist/file/truncateFileName.mjs"
      },
      "require": {
        "types": "./dist/file/truncateFileName.d.ts",
        "default": "./dist/file/truncateFileName.cjs"
      }
    },
    "./file/truncateFileNameParts": {
      "import": {
        "types": "./dist/file/truncateFileNameParts.d.mts",
        "default": "./dist/file/truncateFileNameParts.mjs"
      },
      "require": {
        "types": "./dist/file/truncateFileNameParts.d.ts",
        "default": "./dist/file/truncateFileNameParts.cjs"
      }
    },
    "./uuid/generateUUID": {
      "import": {
        "types": "./dist/uuid/generateUUID.d.mts",
        "default": "./dist/uuid/generateUUID.mjs"
      },
      "require": {
        "types": "./dist/uuid/generateUUID.d.ts",
        "default": "./dist/uuid/generateUUID.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/DungGramer"
  },
  "keywords": [
    "typescript",
    "utilities",
    "tree-shaking",
    "type-safe",
    "validation",
    "file-utils",
    "uuid",
    "esm",
    "cjs"
  ]
}
