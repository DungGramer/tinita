{
  "name": "tinita",
  "version": "0.1.0",
  "description": "Modern TypeScript utility library with tree-shaking support - zero dependencies, type-safe, framework-agnostic",
  "author": {
    "name": "DungGramer",
    "email": "dung.dev.gramer@gmail.com",
    "url": "https://dunggramer.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunggramer/tinita.git",
    "directory": "packages/tinita"
  },
  "homepage": "https://github.com/dunggramer/tinita#readme",
  "bugs": {
    "url": "https://github.com/dunggramer/tinita/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "file/fileSize": [
        "dist/file/fileSize.d.ts"
      ],
      "file/getFileNameParts": [
        "dist/file/getFileNameParts.d.ts"
      ],
      "file/truncateFileName": [
        "dist/file/truncateFileName.d.ts"
      ],
      "file/truncateFileNameParts": [
        "dist/file/truncateFileNameParts.d.ts"
      ],
      "uuid/generateUUID": [
        "dist/uuid/generateUUID.d.ts"
      ],
      "html": [
        "dist/html/html.d.ts"
      ],
      "html/plugin/entities": [
        "dist/html/plugin/entities.d.ts"
      ],
      "converter/bytesToBase64": [
        "dist/converter/bytesToBase64.d.ts"
      ],
      "converter/base64ToBytes": [
        "dist/converter/base64ToBytes.d.ts"
      ],
      "converter/stringToBase64": [
        "dist/converter/stringToBase64.d.ts"
      ],
      "converter/base64ToString": [
        "dist/converter/base64ToString.d.ts"
      ],
      "converter/blobToUint8Array": [
        "dist/converter/blobToUint8Array.d.ts"
      ],
      "converter/blobToBase64": [
        "dist/converter/blobToBase64.d.ts"
      ],
      "converter/base64ToBlob": [
        "dist/converter/base64ToBlob.d.ts"
      ],
      "converter/blobToDataUrl": [
        "dist/converter/blobToDataUrl.d.ts"
      ],
      "converter/dataUrlToBlob": [
        "dist/converter/dataUrlToBlob.d.ts"
      ],
      "converter/objectToFormData": [
        "dist/converter/objectToFormData.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsup",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
