{
  "name": "tinita-dom",
  "version": "0.1.0",
  "description": "Framework-agnostic DOM utilities. Browser-only - see README.",
  "keywords": [
    "dom",
    "smooth-scroll",
    "wheel",
    "scroll"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunggramer/tinita.git",
    "directory": "packages/tinita"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "smooth-scroll": [
        "dist/smooth-scroll.d.ts"
      ],
      "wheel-source": [
        "dist/wheel-source.d.ts"
      ],
      "converter/blobToFile": [
        "dist/converter/blobToFile.d.ts"
      ],
      "converter/base64ToFile": [
        "dist/converter/base64ToFile.d.ts"
      ],
      "converter/uint8ArrayToFile": [
        "dist/converter/uint8ArrayToFile.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./smooth-scroll": {
      "import": {
        "types": "./dist/smooth-scroll.d.mts",
        "default": "./dist/smooth-scroll.mjs"
      },
      "require": {
        "types": "./dist/smooth-scroll.d.ts",
        "default": "./dist/smooth-scroll.cjs"
      }
    },
    "./wheel-source": {
      "import": {
        "types": "./dist/wheel-source.d.mts",
        "default": "./dist/wheel-source.mjs"
      },
      "require": {
        "types": "./dist/wheel-source.d.ts",
        "default": "./dist/wheel-source.cjs"
      }
    },
    "./converter/blobToFile": {
      "import": {
        "types": "./dist/converter/blobToFile.d.mts",
        "default": "./dist/converter/blobToFile.mjs"
      },
      "require": {
        "types": "./dist/converter/blobToFile.d.ts",
        "default": "./dist/converter/blobToFile.cjs"
      }
    },
    "./converter/base64ToFile": {
      "import": {
        "types": "./dist/converter/base64ToFile.d.mts",
        "default": "./dist/converter/base64ToFile.mjs"
      },
      "require": {
        "types": "./dist/converter/base64ToFile.d.ts",
        "default": "./dist/converter/base64ToFile.cjs"
      }
    },
    "./converter/uint8ArrayToFile": {
      "import": {
        "types": "./dist/converter/uint8ArrayToFile.d.mts",
        "default": "./dist/converter/uint8ArrayToFile.mjs"
      },
      "require": {
        "types": "./dist/converter/uint8ArrayToFile.d.ts",
        "default": "./dist/converter/uint8ArrayToFile.cjs"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsup",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  }
}
