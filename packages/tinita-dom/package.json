{
  "name": "tinita-dom",
  "version": "0.1.0",
  "description": "Framework-agnostic DOM utilities. Browser-only - see README.",
  "keywords": [
    "dom",
    "smooth-scroll",
    "wheel",
    "scroll"
  ],
  "license": "MIT",
