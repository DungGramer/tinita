    "@types/node": "^22.15.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cssnano": "^7.1.2",
    "jsdom": "^27.2.0",
    "lucide-react": "^0.555.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "tinita": "workspace:*",
    "vite": "^7.2.6"
