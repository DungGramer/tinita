  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "concurrently \"TNT_FORMAT=es vite build -c vite.config.build.mts --watch\" \"pnpm run build:css --watch\"",
    "build:js": "TNT_FORMAT=es vite build -c vite.config.build.mts && TNT_FORMAT=cjs vite build -c vite.config.build.mts",
    "build:css": "node scripts/build-css.mjs",
    "build": "pnpm run build:js && pnpm run build:types && pnpm run build:css",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test:watch": "vitest",
    "build:types": "tsup"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.8.0",
    "lucide-react": ">=0.400.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "@base-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/postcss": "^4.1.17",
